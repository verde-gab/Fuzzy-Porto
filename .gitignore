# =============================================================
# .gitignore — Fuzzy-Porto
# =============================================================

# ---- Jupyter ----
.ipynb_checkpoints/
**/.ipynb_checkpoints/

# ---- Data (raw > 100 MB — GitHub rejeita) ----
/data/raw/

# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
.venv/
*.egg-info/

# ---- Docker ----
compose.yaml

# ---- Agent context (local-only) ----
/agyREADME.md
/.gemini/

# ---- LaTeX build artifacts ----
# Gerados automaticamente por pdflatex/bibtex/biber — nunca commitar
*.aux
*.bbl
*.blg
*.bcf
*.log
*.nav
*.out
*.snm
*.toc
*.lof
*.lot
*.brf
*.fls
*.fdb_latexmk
*.synctex.gz
*.run.xml

# ---- PDFs compilados (recompilam-se a partir do .tex) ----
/Refs/ingles.pdf
/Refs/Congresso.pdf
/Refs/artigo_principia.pdf
/Refs/relatorio_pic.pdf

# ---- PDF library (livros/artigos — pesados, não redistribuíveis) ----
/Refs/pdf_research/

# ---- Conversion script ----
/Refs/convert_pdfs.sh
