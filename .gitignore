# =============================================================
# .gitignore — Fuzzy-Porto (Apenas Dados e Notebooks)
# =============================================================

# ---- Jupyter (Cache e Checkpoints) ----
.ipynb_checkpoints/
**/.ipynb_checkpoints/

# ---- Python (Ambiente Virtual e Binários) ----
__pycache__/
*.py[cod]
*$py.class
.venv/
*.egg-info/

# ---- Docker ----
compose.yaml

# ---- Agent context (local-only) ----
/agyREADME.md
/.gemini/

# ---- Bloquear toda a pasta de Referências/LaTeX ----
/Refs/

# ---- Ignorar arquivos soltos na raiz (exceto os obrigatórios) ----
# Garante que arquivos temporários ou PDFs perdidos na raiz não subam
*.pdf
*.log
*.aux

